{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)docs' ':(exclude)*.md' ':(exclude).claude'",
  "crons": [
    {
      "path": "/api/cron/mlb-schedule",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/api/cron/weekly-digest?execute=true",
      "schedule": "0 17 * * 2"
    },
    {
      "path": "/api/cron/nightly-refresh",
      "schedule": "15 4,5 * * *"
    },
    {
      "path": "/api/cron/nightly-refresh?batch=cfb",
      "schedule": "15 7,8 * * *"
    }
  ]
}
